            "api",
            "v1",
            "auth",
            "register"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Sukrit User\",\n    \"tel\": \"0812345678\",\n    \"email\": \"{{testUserEmail}}\",\n    \"password\": \"password123\",\n    \"role\": \"user\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var uniqueId = Date.now();",
              "var testEmail = 'master_user_' + uniqueId + '@test.com';",
              "pm.collectionVariables.set('testUserEmail', testEmail);",
              "pm.environment.set('testUserEmail', testEmail);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.success).to.be.true;",
              "if (jsonData.token) {",
              "    pm.environment.set('userToken', jsonData.token);",
              "    pm.collectionVariables.set('userToken', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
